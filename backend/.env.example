# Copy to backend/.env and fill in. backend/.env is never committed.

# Local Supabase (supabase start). Postgres direct connection; the schema comes from Flyway.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:55321
# From `supabase status` (service_role key). Server only, never put it in web/.
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Gemini (Google AI Studio key). Don't set up billing if you want it to stay on the free tier.
# Free-tier requests may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Claude Code CLI: leave empty to find `claude` on PATH.
CLAUDE_BIN=

# Ollama (local VLM)
OLLAMA_URL=http://127.0.0.1:11434
